#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.grafana/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
grafana-sbom.pcs: software bill of materials of the Grafana hereWeb capability.
Debian does not package Grafana: the OSS tarball is fetched from upstream at a pinned version,
verified against its pinned checksum, by a func-bearing pseudo-package. The config provisions this
host's Prometheus as the default datasource and a small host dashboard, so Grafana is useful out of
the box. The admin login is admin / grafana (the rawBisos convention; insecure by design).
This is the server only. The usage side (gcx, the CLI for Grafana's API) is grafanaUsage-sbom.pcs,
which this sbom does not pull in; grafanaCbs-sbom.pcs, the sbom of grafana-cbs.pcs, runs both.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.banna import sysAccts
from bisos.grafana.grafanaInfo import (
    grafanaInfo, distSetupScript, iniFileContent, envFileContent,
    datasourceContent, dashboardProviderContent, hostDashboardContent,
)

ap = pkgsSeed.aptPkg

# The facts of the installation --- account, versions, checksums, paths, env file, ports,
# login --- come from bisos.grafana.grafanaInfo, the one source the unit, grafanaAdmin.cs,
# dns and vhost read too.
#
# Each func-bearing pseudo-package below is registered in aptPkgsList, so sbom_csu's
# aptPkgs_update() calls it instead of apt-get install. Its gate,
# aptPkg_isInstalled("<name>"), can never be true --- so each runs on *every*
# sbom_fullUpdate and must stay idempotent. Ordering in aptPkgsList is load-bearing.


def _bash(script: str) -> b.op.Outcome:
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(script)
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def grafanaAcctSetup():
    """The grafana system account and the dirs it must own. Not an apt package.

    The uid/gid come from bisos.banna.sysAccts, so the account has the same numbers on
    every BISOS platform.
    """
    return _bash(f"""
set -e
{sysAccts.useraddScript(grafanaInfo.acctName)}

sudo mkdir -p {grafanaInfo.pluginsDir} {grafanaInfo.confDir} {grafanaInfo.installBase}
sudo chown -R {grafanaInfo.acctName}:{grafanaInfo.acctName} {grafanaInfo.dataDir}
sudo chmod 750 {grafanaInfo.dataDir}
""")


def grafanaDistSetup():
    """The pinned Grafana OSS tarball, verified, unpacked root-owned, current -> it. Not an apt package."""
    return _bash(distSetupScript())


def _writeIfAbsent(path, content: str, tag: str) -> str:
    return f"""
sudo mkdir -p {path.parent}
if [ ! -f {path} ] ; then
    sudo tee {path} >/dev/null <<'{tag}'
{content}{tag}
fi
sudo chown root:{grafanaInfo.acctName} {path}
sudo chmod 640 {path}
"""


def grafanaConfSetup():
    """grafana.ini, /etc/default/grafana and the provisioning files. Not an apt package.

    Each is written only when absent, so hand overrides survive re-runs; grafanaAdmin.cs -i
    driftCheck reports how they differ from the generators. Grafana warns about provisioning
    directories that do not exist, so all four are created.
    """
    prov = grafanaInfo.provisioningDir
    return _bash("set -e\n"
                 + _writeIfAbsent(grafanaInfo.iniFile, iniFileContent(), "GRAFANA_INI_EOF")
                 + _writeIfAbsent(grafanaInfo.envFile, envFileContent(), "GRAFANA_ENV_EOF")
                 + _writeIfAbsent(grafanaInfo.datasourceFile, datasourceContent(), "GRAFANA_DS_EOF")
                 + _writeIfAbsent(grafanaInfo.dashboardProviderFile, dashboardProviderContent(), "GRAFANA_DB_EOF")
                 + _writeIfAbsent(grafanaInfo.hostDashboardFile, hostDashboardContent(), "GRAFANA_HOST_EOF")
                 + f"sudo mkdir -p {prov}/plugins {prov}/alerting\n"
                 + f"sudo chgrp {grafanaInfo.acctName} {grafanaInfo.confDir} {prov} {prov}/* {grafanaInfo.dashboardsDir}\n"
                 + f"sudo chmod 750 {grafanaInfo.confDir} {prov} {prov}/* {grafanaInfo.dashboardsDir}\n")


aptPkgsList = [
    ap("curl"),                                         # Fetches the upstream tarball
    ap("grafanaAcctSetup", func=grafanaAcctSetup),
    ap("grafanaDistSetup", func=grafanaDistSetup),     # after curl and the account dirs
    ap("grafanaConfSetup", func=grafanaConfSetup),
]

# No pip packages, and nothing for using Grafana's API: that is grafanaUsage-sbom.pcs.

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: Grafana OSS {grafanaInfo.version} for this host, browsed as {grafanaInfo.baseUrl}
   Login: {grafanaInfo.adminUser} / {grafanaInfo.adminPassword}  (rawBisos convention; insecure by design)

** What this installs:
  1) apt package: curl.
  2) grafanaAcctSetup: the {grafanaInfo.acctName} system account, with uid/gid
     {sysAccts.sysAcctOf(grafanaInfo.acctName).uid} from bisos.banna.sysAccts, and {grafanaInfo.dataDir}.
  3) grafanaDistSetup: {grafanaInfo.distUrl()}
     verified by SHA-256, unpacked root-owned into {grafanaInfo.distDir},
     with {grafanaInfo.homeLink} pointing at it.
  4) grafanaConfSetup (each written only when absent):
       {grafanaInfo.iniFile}       loopback listener, grafana.here, login, no phoning home
       {grafanaInfo.envFile}
       {grafanaInfo.datasourceFile}   Prometheus at {grafanaInfo.prometheusUrl}, default
       {grafanaInfo.dashboardProviderFile} + {grafanaInfo.hostDashboardFile}

** Listener (loopback; port from bisos.banna):
     grafana  {grafanaInfo.localUrl}   (nginx: {grafanaInfo.baseUrl})

** What this does NOT do:
  - It does not start anything. The grafana unit is declared by grafana-cbs.pcs, which also
    runs this sbom (through grafanaCbs-sbom.pcs).
  - It does not install Prometheus: the datasource points at bisos.prometheus's port, and is
    simply unreachable on a host without it.
  - It installs nothing for using Grafana's API: that is grafanaUsage-sbom.pcs (gcx), which
    this sbom does not pull in.

       grafana-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Grafana -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("grafana-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal(f"{grafanaInfo.grafanaBin} --version")
    literal(f"ls -l {grafanaInfo.homeLink}")
    literal(f"sudo cat {grafanaInfo.iniFile}")

    cs.examples.menuChapter('*End-Of Grafana -- sbom Examples*')
    return cmndOutcome
