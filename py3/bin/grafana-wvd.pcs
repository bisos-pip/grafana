#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for grafana.here NGINX virtual-host (capWebVd) --- fronts Grafana
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo
from bisos.grafana.grafanaInfo import grafanaInfo

serverName = grafanaInfo.fqdn
# Grafana binds grafanaInfo.listenIp (loopback) only, so nginx proxies to that address
# rather than to the grafana.here one.
proxyIp = grafanaInfo.listenIp
proxyPort = grafanaInfo.portNu

def wvdConfigFunc() -> str:
    """A reverse proxy to Grafana on loopback, plus the WebSocket upgrade Grafana Live needs.

    Without the /api/live/ location, live panels and the alerting UI's live updates fail to
    connect, and Grafana logs "origin not allowed" / websocket errors.
    """
    return f"""\
server {{
    listen 80;
    server_name {serverName};

    location / {{
        proxy_pass http://{proxyIp}:{proxyPort};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }}

    location /api/live/ {{
        proxy_pass http://{proxyIp}:{proxyPort};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }}
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort=proxyPort,
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
