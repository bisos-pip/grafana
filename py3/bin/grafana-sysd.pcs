""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.grafana/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
The grafana.service unit. --homepath is the unpacked tarball (through the current link), where
Grafana finds conf/defaults.ini and its static files; --config is the generated grafana.ini.
Overrides go in /etc/default/grafana as GF_<SECTION>_<KEY>=value.
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.grafana.grafanaInfo import grafanaInfo, sysdServiceLines

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    # Not on PATH: the binary lives under grafanaInfo.homeLink, so whichBinPath() cannot find it.
    if not ( execPath := grafanaInfo.grafanaBin ).exists():
        return None

    templateStr = f"""
[Unit]
Description=Grafana
After=network.target

[Service]
Type=simple
{sysdServiceLines(grafanaInfo.envFile)}WorkingDirectory={grafanaInfo.homeLink}
ExecStart={execPath} server --homepath={grafanaInfo.homeLink} --config={grafanaInfo.iniFile}
LimitNOFILE=10000
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="grafana",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
