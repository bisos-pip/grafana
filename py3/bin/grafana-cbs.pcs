#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.grafana/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
grafana-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- Grafana as grafana.here
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: grafanaCbs-sbom.pcs, which runs grafana-sbom.pcs (account, Grafana, config,
provisioning) and grafanaUsage-sbom.pcs (gcx); the grafana unit; and grafana-assemble.cs
(grafana.here dns + nginx vhost).
cba_seed takes one sbom, hence grafanaCbs-sbom.pcs rather than both names here.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom="grafanaCbs-sbom.pcs",
    assemble="grafana-assemble.cs",
    materialize=None,
)

sysdUnitsListGrafana = [
    cba_sysd_seed.sysdUnit("grafana", "grafana-sysd.pcs"),
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListGrafana,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
