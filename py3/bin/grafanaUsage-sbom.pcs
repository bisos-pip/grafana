#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.grafana/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
grafanaUsage-sbom.pcs: software bill of materials of the usage side of the Grafana capability ---
what a host needs to use a Grafana server through its HTTP API, local or remote, as opposed to run
one. That is gcx, Grafana Labs' CLI for the API (it replaced grafanactl), a single binary released
on GitHub, pinned and checksummed here.
It does not need the server. grafana-sbom.pcs does not pull this sbom in; grafanaCbs-sbom.pcs,
the sbom of grafana-cbs.pcs, runs both.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.grafana.grafanaInfo import grafanaInfo, gcxSetupScript

ap = pkgsSeed.aptPkg


def _bash(script: str) -> b.op.Outcome:
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(script)
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def gcxSetup():
    """The pinned gcx tarball, verified, unpacked root-owned, gcx -> it. Not an apt package. Idempotent."""
    return _bash(gcxSetupScript())


aptPkgsList = [
    ap("curl"),                             # Fetches the upstream tarball
    ap("gcxSetup", func=gcxSetup),          # after curl
]

# No pip packages: grafana-foundation-sdk (dashboards as code, from Grafana Labs) installs into
# each consumer's own virtenv, through that consumer's sbom.

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = f"""\
** Scope: the usage side of the Grafana capability -- what a host needs to use a Grafana
   server's API (this host's or another's), not to run one. Part of bisos.grafana.

** What this installs:
  1) apt package: curl.
  2) gcxSetup: gcx {grafanaInfo.gcxVersion} from {grafanaInfo.gcxUrl()}
     verified by SHA-256, into {grafanaInfo.gcxDir}, with {grafanaInfo.gcxLink} pointing at it.

** Standalone: this sbom does not need the server. grafana-sbom.pcs does not pull it in;
   grafana-cbs.pcs runs both, through grafanaCbs-sbom.pcs.

** To use it with this host's Grafana (the rawBisos login). gcx keeps credentials in the OS
   keychain and will not fall back to a file; a BISOS host has none, hence GCX_KEYCHAIN=off
   (plaintext under ~/.config/gcx):
       {grafanaInfo.gcxLogin}
       GCX_KEYCHAIN=off {grafanaInfo.gcxBin} dashboards list

** What this does NOT do:
  - It installs no Python libraries; grafana-foundation-sdk (dashboards as code) belongs
    to each consumer's virtenv.

       grafanaUsage-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Grafana Usage -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("grafanaUsage-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Use It*')
    literal(f"{grafanaInfo.gcxBin} --version")
    literal(f"{grafanaInfo.gcxLogin}")
    literal(f"GCX_KEYCHAIN=off {grafanaInfo.gcxBin} dashboards list")
    literal(f"GCX_KEYCHAIN=off {grafanaInfo.gcxBin} datasources list")

    cs.examples.menuChapter('*End-Of Grafana Usage -- sbom Examples*')
    return cmndOutcome
